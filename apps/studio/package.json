{
  "name": "@autotype/studio",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"tsup --watch\" \"wait-on dist-electron/main.cjs tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron dist-electron/main.cjs\"",
    "dev:web": "vite --host 127.0.0.1",
    "build": "vite build && tsup",
    "check": "tsc --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "package": "npm run build && electron-builder"
  },
  "dependencies": {
    "@autotype/core": "*",
    "@monaco-editor/react": "^4.7.0",
    "@remotion/bundler": "^4.0.0",
    "@remotion/renderer": "^4.0.0",
    "lucide-react": "^0.468.0",
    "monaco-editor": "^0.52.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "remotion": "^4.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.4.0",
    "concurrently": "^9.2.0",
    "cross-env": "^7.0.3",
    "electron": "^37.0.0",
    "electron-builder": "^26.0.0",
    "tailwindcss": "^4.1.0",
    "tsup": "^8.5.0",
    "typescript": "^5.8.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.0",
    "wait-on": "^8.0.0"
  },
  "build": {
    "appId": "com.autotype.recorder",
    "productName": "AutoType Recorder",
    "directories": { "output": "release" },
    "files": ["dist/**/*", "dist-electron/**/*", "src/remotion/**/*", "package.json"],
    "win": { "target": "nsis" },
    "mac": { "target": "dmg" },
    "linux": { "target": "AppImage" }
  }
}
